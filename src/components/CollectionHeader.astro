---
import CollectionNav from './CollectionNav.astro';

interface Props {
  current: 'about' | 'projects' | 'blog';
}

const { current } = Astro.props;
---

<div class="collection-heading">
  <CollectionNav current={current} />
  <a href="#landing" class="back-to-orbit">Back to orbit <span aria-hidden="true">↑</span></a>
</div>
